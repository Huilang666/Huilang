{
  "name": "dsh-emotion-tower",
  "version": "3.1.3",
  "description": "基于L层沙盒尖塔结构的连续情绪生成器。",
  "private": true,
  "type": "module",
  "main": "src/js/index.js",
  "exports": {
    ".": "./src/js/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "emotion",
    "emotion-tower"
  ],
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "check": "node --check src/js/index.js",
    "dev": "cd src/js && node index.js"
  },
  "license": "MIT",
  "author": "Nich / 大肥鱼情绪系统",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "tools"
      ]
    }
  },
  "config": {
    "time_constant": 5.0,
    "max_events": 100,
    "compute_freq": 1.0,
    "output_format": "json"
  }
}
{
  "name": "dsh-emotion-tower",
  "version": "3.1.0",
  "description": "基于L层沙盒尖塔结构的连续情绪生成器。",
  "private": true,
  "type": "module",
  "main": "./src/js/index.js",
  "exports": {
    ".": "./src/js/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "node --check src/js/index.js",
    "dev": "cd src/js && node index.js"
  },
  "license": "MIT",
  "author": "Nich / 大肥鱼情绪系统",
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "name": "emotion-tower"
  },
  "config": {
    "time_constant": 5.0,
    "max_events": 100,
    "compute_freq": 1.0,
    "output_format": "json"
  }
}